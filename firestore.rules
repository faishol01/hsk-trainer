rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/progress/{bucket} {
      function owner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function valid() {
        let d = request.resource.data;
        return d.keys().hasAll(['v', 'd', 'k', 'c', 't'])
          && d.keys().hasOnly(['v', 'd', 'k', 'c', 't'])
          && d.v == 1 && d.d is string
          && d.d.matches('^[a-zA-Z0-9-]{16,64}$')
          && d.k in ['q', 'f']
          && bucket.matches('^' + d.d + '_' + d.k + '_[0-3]$')
          && d.c is map && d.c.size() <= 2500
          && d.t == request.time;
      }
      allow read: if owner();
      allow create: if owner() && valid();
      allow update: if owner() && valid()
        && request.resource.data.d == resource.data.d
        && request.resource.data.k == resource.data.k;
      allow delete: if false;
    }
  }
}
